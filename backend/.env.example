# Copy these settings into backend/.env. Keep real API keys out of source control.
OPENWEATHER_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# 비용 정산: 계좌번호·증빙 이미지는 백엔드(service role)만 접근합니다. 절대 프론트나 git에 넣지 마세요.
SUPABASE_SERVICE_ROLE_KEY=

# Room diary backup. Use the same Web OAuth client ID as REACT_APP_GOOGLE_CLIENT_ID.
SUPABASE_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 32 random bytes encoded as 64 hex characters. Keep this key stable after deployment.
GOOGLE_DRIVE_TOKEN_KEY=
GOOGLE_OAUTH_ALLOWED_ORIGINS=http://localhost:8080,https://meetup-syk15151.apps.dauai.org
